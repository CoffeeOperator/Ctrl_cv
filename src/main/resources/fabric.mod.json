{
  "schemaVersion": 1,
  "id": "ctrl_cv",
  "version": "${version}",
  "name": "Ctrl_cv",
  "description": "Custom combat extension utility framework.",
  "authors": [
    "YourName"
  ],
  "contact": {
    "sources": "https://github.com"
  },
  "icon": "assets/template/icon.png",
